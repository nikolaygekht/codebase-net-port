<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CodeBase.Net</RootNamespace>
    <AssemblyName>CodeBase.Net</AssemblyName>

    <!-- API help is generated by Gehtsoft docgen from these comments (ADR-15). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Description>A C#/.NET port of the CodeBase xBase engine: byte-compatible DBF, CDX and FPT.</Description>
    <Copyright>Copyright (C) 2026 Nikolay Gekht</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    No PackageReference belongs here. The library has no NuGet dependencies at all,
    deliberately: encoding providers are registered by the host application, never by
    us (ADR-17). If something here seems to need System.Text.Encoding.CodePages, the
    fix is in the host's documentation, not in this file.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="CodeBase.Net.Tests" />
    <InternalsVisibleTo Include="CodeBase.Net.Golden" />
    <InternalsVisibleTo Include="CodeBase.Net.TestUtils" />
    <!-- Moq builds proxies of the internal boundary interfaces from a generated assembly. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
