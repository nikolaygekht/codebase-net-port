<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Windows-only developer tool, like the generator beside it, and not part of the solution:
       it asks Windows what WideCharToMultiByte does and writes the answer as library data. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same version the test projects register, so the comparison is against the tables
         the library is tested with. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
