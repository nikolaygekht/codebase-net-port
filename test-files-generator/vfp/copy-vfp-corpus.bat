@echo off
REM ===========================================================================
REM  copy-vfp-corpus.bat — publishes the VFP oracle's output into the
REM  checked-in corpus, in its own frozen corner.
REM
REM      copy-vfp-corpus.bat            copy out       -> ..\..\net\corpus\vfp
REM      copy-vfp-corpus.bat <srcdir>   copy <srcdir>  -> ..\..\net\corpus\vfp
REM
REM  Run vfpfunc.prg in the VFP 9 VM first (DO vfpfunc.prg).
REM
REM  Why a subdirectory. net\corpus is discovered non-recursively
REM  (CodeBase.Net.TestUtils Corpus.TableNames), so these tables are invisible
REM  to the data-driven golden tests that expect a C-written <NAME>.dump.txt
REM  beside every table. Their gates name them explicitly — the same
REM  arrangement benchmark\ already uses, and for the same reason.
REM
REM  These files are NOT regenerated by the C generator and are not part of
REM  its byte-identical regeneration property (ADR-44). Nothing is deleted
REM  here, so check `git status` after copying.
REM ===========================================================================
setlocal

set "ROOT=%~dp0"
set "SRC=%~1"
if "%SRC%"=="" set "SRC=%ROOT%out"
set "DEST=%ROOT%..\..\net\corpus\vfp"

if not exist "%SRC%\*.DBF" (
   echo [copy-vfp] ERROR: no .DBF files in %SRC%
   echo [copy-vfp] Run vfpfunc.prg in the VFP 9 VM first.
   exit /b 1
)

if not exist "%DEST%" mkdir "%DEST%"

echo [copy-vfp] %SRC%
echo [copy-vfp]   -^> %DEST%

REM  VFP writes the table as .DBF and its companions in the same case it was
REM  asked for; the dumps this script's .prg writes are *.vfp.dump.txt.
for %%X in (DBF fpt cdx CDX vfp.dump.txt) do (
   if exist "%SRC%\*.%%X" (
      copy /y "%SRC%\*.%%X" "%DEST%\" >nul || (
         echo [copy-vfp] ERROR: copy of *.%%X failed
         exit /b 1
      )
      for %%F in ("%SRC%\*.%%X") do echo [copy-vfp]      %%~nxF
   )
)

echo [copy-vfp] OK
endlocal
exit /b 0
